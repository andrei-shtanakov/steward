#!/bin/sh
# pre-push: ревью того, что РЕАЛЬНО отправляется.
#
# Git передаёт сюда через stdin строки `<local ref> <local sha> <remote ref>
# <remote sha>` — фактически отправляемые ссылки, которые с HEAD совпадать не
# обязаны. Безусловное ревью HEAD означало бы проверить одно дерево, а
# отправить другое: результат выглядел бы доказательством, не будучи им.
#
# Хук НЕ является governance evidence и ничего не публикует. `--no-verify` —
# штатный осознанный обход.
set -eu

# Git передаёт имя remote первым аргументом хука (контракт `pre-push
# <remote name> <remote url>`) — используем то, что реально дано, а не
# зашиваем "origin": `git clone -o github`, переименованный remote, или пуш
# в `upstream` при наличии обоих иначе молча ревьюили бы диапазон от НЕ
# ТОГО remote'а, чем тот, куда ветка реально уходит. `${1:-origin}` —
# защита на случай прямого вызова без аргументов (тесты, отладка); от
# настоящего git всегда приходит реальное имя.
remote_name="${1:-origin}"

kit_dir="${REVIEW_KIT_DIR:-$(git rev-parse --show-toplevel)/scripts/review}"
head_sha="${REVIEW_HEAD_SHA:-$(git rev-parse HEAD)}"

# Хук живёт в `.git/hooks` (или в `core.hooksPath`) и потому активен ВСЕГДА,
# независимо от того, что лежит в рабочем дереве прямо сейчас: старая
# release-ветка, исторический коммит до появления кита, bisect — обычная
# работа, не краевой случай. `scripts/review/` там может не существовать.
# Раньше это обнаруживалось только на самом вызове `sh "$kit_dir/local.sh"`
# в конце файла — под `set -e` сырая ошибка shell'а ("cannot open"), пуш
# заблокирован, и подсказка про --no-verify даже не печаталась. Дерево, к
# которому инструмент не относится, — не повод его блокировать: пропускаем
# пуш честным кодом 0 с понятным сообщением, а не отказом худшего сорта
# (без объяснения и без названного выхода). Проверка — ДО разбора stdin: раз
# ревьюить нечем, дальнейший разбор формы пуша не нужен вовсе.
if [ ! -r "$kit_dir/local.sh" ]; then
    echo "pre-push review: кит недоступен в этом чекауте" \
        "($kit_dir/local.sh не найден или нечитаем) — ревью пропущено." >&2
    exit 0
fi

lines=$(cat)
count=$(printf '%s' "$lines" | grep -c . || true)

# $2 — sha, который реально стоит подставить в подсказку --head, если он на
# момент вызова известен и осмыслен (не пусто, не все нули). Параметром, а не
# обращением к $local_sha изнутри: local_sha ещё не разобран на строке 27, и
# под `set -u` чтение неустановленной переменной уронило бы хук по чужой
# причине — ровно тот класс находки, который мы ловим весь день. Пустой $2 —
# честный случай "подставить нечего", а не фиктивный `<sha>`-плейсхолдер,
# выданный за готовую команду.
#
# Четвёртый заход на одно и то же обещание подсказки ("исполнима как есть"):
# был плейсхолдер вместо sha, была база вместо головы, был путь без кавычек,
# теперь — "[--base <ref>]" в хвосте. Скобочная нотация читается человеком
# как "необязательно", а для самого `sh` `<ref>` — оператор редиректа
# stdin, и команда падает до запуска кита. Печатаем ТОЛЬКО когда реально
# есть что запускать (hint_sha не пуст) и ТОЛЬКО то, что действительно
# запускается без правок; --base — отдельной строкой прозой, не частью
# команды.
unsupported() {
    reason="$1"
    hint_sha="${2:-}"
    echo "pre-push review: форма пуша не поддержана — $reason" >&2
    if [ -n "$hint_sha" ]; then
        echo "Проверить нужное вручную:" >&2
        echo "  sh \"$kit_dir/local.sh\" --head $hint_sha --remote $remote_name" >&2
        echo "(при необходимости добавьте: --base <ветка-цель>)" >&2
    else
        echo "Нечего проверить вручную: для этой формы пуша нет sha," >&2
        echo "которую можно было бы отревьюить." >&2
    fi
    echo "Либо отправить без ревью: git push --no-verify" >&2
    exit 1
}

# Ноль ссылок — не неоднозначная форма: git включает ref в stdin тогда и
# только тогда, когда old_sha != new_sha (доказано живым экспериментом,
# см. progress.md). Значит по проводу не идёт НИЧЕГО, и подменять проверкой
# нечего — это честное "отправлять нечего", а не unsupported-форма. Настоящий
# повторный `git push`, которому нечего отправлять, обязан остаться зелёным,
# как и до этой ветки ("Everything up-to-date").
if [ "$count" -eq 0 ]; then
    echo "pre-push review: отправлять нечего." >&2
    exit 0
fi

[ "$count" -eq 1 ] || unsupported "ожидалась ровно одна ссылка, получено $count"

# Только первая строка: если её разбор случайно окажется валиден сам по себе
# (ветка на HEAD), а проверку выше на "ровно одна ссылка" убрать или обойти —
# вторая, протащенная строка не должна тихо остаться непроверенной. awk по
# ВСЕМ строкам здесь дал бы то же самое случайно (через несовпадение
# многострочного local_sha с однострочным head_sha) — это хрупкая, не
# предусмотренная защита; head -1 делает разбор детерминированным, а проверку
# count выше — единственным и обязательным стражем от лишних строк.
local_ref=$(printf '%s' "$lines" | head -1 | awk '{print $1}')
local_sha=$(printf '%s' "$lines" | head -1 | awk '{print $2}')
remote_ref=$(printf '%s' "$lines" | head -1 | awk '{print $3}')

# Нули (удаление ветки) — не настоящий sha, подсказывать его нечего.
sha_hint=""
case "$local_sha" in
    *[!0]*) sha_hint="$local_sha" ;;
esac

# Настоящий git на удалении ветки шлёт литеральное `(delete)` как local ref
# (проверено эхо-хуком на обеих формах, `git push origin --delete x` и
# `git push origin :x`), поэтому удаление ловится ЗДЕСЬ, через "не ветка" —
# отдельного стража на нулевой local_sha ниже по коду не было и не должно
# быть: `refs/heads/*` в паре с (delete)-local-ref никогда одновременно не
# случаются, так что такой страж был бы недостижим и лишь маскировал бы
# место, где реально ловится это условие.
#
# `HEAD` — тоже настоящий local ref, не только `refs/heads/*`: git подставляет
# литеральную строку `HEAD`, когда источник пуша задан как `HEAD` (`git push
# origin HEAD`, `git push origin HEAD:feature`), а не именем ветки. Смысл
# проверки — "это не тег и не удаление", а не "строка начинается с
# refs/heads/" — удаление по-прежнему ловится здесь же (через `(delete)`).
# Сама безопасность — что local sha совпадает с настоящим HEAD — проверяется
# ниже, для ЛЮБОГО принятого сюда ref'а, а не только для `HEAD`-формы.
case "$local_ref" in
    refs/heads/*|HEAD) ;;
    *) unsupported "отправляется не ветка ($local_ref)" "$sha_hint" ;;
esac

# КУДА летит пуш решает remote_ref, а не local_ref: `git push origin
# HEAD:refs/tags/v1` даёт local_ref=HEAD (безопасная форма, принята выше
# именно ради обычных `git push origin HEAD`) и remote_ref=refs/tags/v1 —
# тег ушёл бы на remote непровизьюенным, хотя пуш тега заявлен
# неподдержанным (§8.1) и README обещает его блокировку. local_ref один не
# решает направление пуша; remote_ref обязан быть тоже веткой независимо от
# того, чем оказался local_ref.
case "$remote_ref" in
    refs/heads/*) ;;
    *) unsupported "принимающая ссылка не ветка ($remote_ref)" "$sha_hint" ;;
esac

if [ "$local_sha" != "$head_sha" ]; then
    unsupported "отправляется $local_sha, а HEAD сейчас $head_sha" "$sha_hint"
fi

# TOCTOU: между проверкой выше и этим вызовом HEAD может уехать (commit
# --amend, вторая консоль, фоновый процесс) — без явного --head local.sh
# резолвил бы СВОЙ собственный `git rev-parse HEAD` заново и провизьюил бы
# то, чем HEAD оказался К МОМЕНТУ ВЫЗОВА, а не то, что git реально
# зафиксировал на входе хука ($local_sha). Ровно «проверили одно, отправили
# другое» — состояние, ради запрета которого весь контракт по ref'ам и
# написан. $local_sha уже прошёл проверку равенства с $head_sha выше, так
# что подстановка ничего не смягчает — она закрывает окно гонки.
sh "$kit_dir/local.sh" --head "$local_sha" --remote "$remote_name"
