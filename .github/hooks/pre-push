#!/bin/sh
# pre-push: ревью того, что РЕАЛЬНО отправляется.
#
# Git передаёт сюда через stdin строки `<local ref> <local sha> <remote ref>
# <remote sha>` — фактически отправляемые ссылки, которые с HEAD совпадать не
# обязаны. Безусловное ревью HEAD означало бы проверить одно дерево, а
# отправить другое: результат выглядел бы доказательством, не будучи им.
#
# Хук НЕ является governance evidence и ничего не публикует. `--no-verify` —
# штатный осознанный обход.
set -eu

kit_dir="${REVIEW_KIT_DIR:-$(git rev-parse --show-toplevel)/scripts/review}"
head_sha="${REVIEW_HEAD_SHA:-$(git rev-parse HEAD)}"

lines=$(cat)
count=$(printf '%s' "$lines" | grep -c . || true)

# $2 — sha, который реально стоит подставить в подсказку --head, если он на
# момент вызова известен и осмыслен (не пусто, не все нули). Параметром, а не
# обращением к $local_sha изнутри: local_sha ещё не разобран на строке 27, и
# под `set -u` чтение неустановленной переменной уронило бы хук по чужой
# причине — ровно тот класс находки, который мы ловим весь день. Пустой $2 —
# честный случай "подставить нечего", а не фиктивный `<sha>`-плейсхолдер,
# выданный за готовую команду.
unsupported() {
    reason="$1"
    hint_sha="${2:-}"
    echo "pre-push review: форма пуша не поддержана — $reason" >&2
    echo "Проверить нужное вручную:" >&2
    if [ -n "$hint_sha" ]; then
        echo "  sh $kit_dir/local.sh --head $hint_sha [--base <ref>]" >&2
    else
        echo "  sh $kit_dir/local.sh --head <sha нужной ссылки> [--base <ref>]" >&2
    fi
    echo "Либо отправить без ревью: git push --no-verify" >&2
    exit 1
}

# Ноль ссылок — не неоднозначная форма: git включает ref в stdin тогда и
# только тогда, когда old_sha != new_sha (доказано живым экспериментом,
# см. progress.md). Значит по проводу не идёт НИЧЕГО, и подменять проверкой
# нечего — это честное "отправлять нечего", а не unsupported-форма. Настоящий
# повторный `git push`, которому нечего отправлять, обязан остаться зелёным,
# как и до этой ветки ("Everything up-to-date").
if [ "$count" -eq 0 ]; then
    echo "pre-push review: отправлять нечего." >&2
    exit 0
fi

[ "$count" -eq 1 ] || unsupported "ожидалась ровно одна ссылка, получено $count"

# Только первая строка: если её разбор случайно окажется валиден сам по себе
# (ветка на HEAD), а проверку выше на "ровно одна ссылка" убрать или обойти —
# вторая, протащенная строка не должна тихо остаться непроверенной. awk по
# ВСЕМ строкам здесь дал бы то же самое случайно (через несовпадение
# многострочного local_sha с однострочным head_sha) — это хрупкая, не
# предусмотренная защита; head -1 делает разбор детерминированным, а проверку
# count выше — единственным и обязательным стражем от лишних строк.
local_ref=$(printf '%s' "$lines" | head -1 | awk '{print $1}')
local_sha=$(printf '%s' "$lines" | head -1 | awk '{print $2}')

# Нули (удаление ветки) — не настоящий sha, подсказывать его нечего.
sha_hint=""
case "$local_sha" in
    *[!0]*) sha_hint="$local_sha" ;;
esac

# Настоящий git на удалении ветки шлёт литеральное `(delete)` как local ref
# (проверено эхо-хуком на обеих формах, `git push origin --delete x` и
# `git push origin :x`), поэтому удаление ловится ЗДЕСЬ, через "не ветка" —
# отдельного стража на нулевой local_sha ниже по коду не было и не должно
# быть: `refs/heads/*` в паре с (delete)-local-ref никогда одновременно не
# случаются, так что такой страж был бы недостижим и лишь маскировал бы
# место, где реально ловится это условие.
case "$local_ref" in
    refs/heads/*) ;;
    *) unsupported "отправляется не ветка ($local_ref)" "$sha_hint" ;;
esac

if [ "$local_sha" != "$head_sha" ]; then
    unsupported "отправляется $local_sha, а HEAD сейчас $head_sha" "$sha_hint"
fi

sh "$kit_dir/local.sh"
