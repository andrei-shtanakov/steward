# Декларация generated-файлов — SSOT для codex-review-кита: пути, помеченные
# linguist-generated, опускаются из дифа ревью именованным маркером и
# проверяются на согласованность с источником по дереву, не построчно
# (scripts/review/local.sh читает атрибут из дерева ревьюируемого коммита
# через `git check-attr --source`). Тот же атрибут понимает сам GitHub
# (сворачивание дифов в UI). Объявление — решение репо и проходит ревью
# через PR; не объявлено — ревьюируется построчно.
uv.lock linguist-generated=true
